# ==============================================================================
# Gitignore for Adversarial Machine Learning Protocol Classifier Project
# ==============================================================================

# ── Dataset (Large files excluded from VCS) ──────────────────────────────────
dataset/
data/
*.csv
*.tsv
*.pcap
*.pcapng
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# ── LaTeX Auxiliary Build Artifacts ──────────────────────────────────────────
# Note: Keep report.pdf, report.tex, and figures/ tracked
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.dvi
*.ps

# ── Jupyter Notebook & Python ────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.whl

# ── Virtual Environments ─────────────────────────────────────────────────────
venv/
env/
.env
.venv/
ENV/
env.bak/
venv.bak/

# ── Model Weights, Checkpoints & Training Runs ───────────────────────────────
*.pkl
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
checkpoints/
runs/
wandb/
.wandb/

# ── Google Colab / Cloud Environments ────────────────────────────────────────
drive/
content/
sample_data/
.colab/

# ── Operating System & Editor Files ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
